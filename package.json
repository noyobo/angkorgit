{
  "name": "angkorgit",
  "version": "0.12.0",
  "private": true,
  "description": "AngKorGit — a modern, fast, beautiful cross-platform Git client inspired by the craftsmanship of Angkor Wat.",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "@tauri-apps/cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "tauri": "bun run --cwd apps/desktop tauri",
    "tauri:dev": "bun run --cwd apps/desktop tauri dev",
    "tauri:build": "make build-app",
    "release:mac": "bun tauri:build && open apps/desktop/src-tauri/target/release/bundle/dmg",
    "install:mac": "rm -rf /Applications/AngKorGit.app && ditto apps/desktop/src-tauri/target/release/bundle/macos/AngKorGit.app /Applications/AngKorGit.app && open -a /Applications/AngKorGit.app",
    "build": "bun run --filter '*' build",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test ./tests/unit",
    "test:watch": "bun test ./tests/unit --watch",
    "test:e2e": "rstest tests/e2e/smoke.test.ts",
    "test:e2e:server": "bun --filter @angkorgit/desktop dev",
    "icons": "bun scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@happy-dom/global-registrator": "^20.14.5",
    "@rstest/adapter-rspack": "^0.11.12",
    "@rstest/core": "^0.11.12",
    "@rstest/playwright": "^0.11.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
